{
  "name": "braintree-vue3",
  "version": "0.1.0",
  "description": "Vue 3 composables wrapping the Braintree Web SDK",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": ["vue", "vue3", "braintree", "composable", "payment"],
  "files": ["dist", "README.md"],
  "main": "./dist/braintree-vue3.cjs",
  "module": "./dist/braintree-vue3.js",
  "types": "./dist/braintree-vue3.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/braintree-vue3.d.ts",
        "default": "./dist/braintree-vue3.js"
      },
      "require": {
        "types": "./dist/braintree-vue3.d.cts",
        "default": "./dist/braintree-vue3.cjs"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "publint && attw --pack",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "peerDependencies": {
    "braintree-web": "^3.x",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/braintree-web": "^3.96.17",
    "@vitejs/plugin-vue": "^5.0.0",
    "braintree-web": "^3.138.0",
    "publint": "^0.3.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.0.0"
  }
}
